# microCMS (events). Leave empty to use the mock events in src/data/events.ts.
# Service ID = the "xxxx" part of https://xxxx.microcms.io
MICROCMS_SERVICE_DOMAIN=
# API key with GET permission for the `events` endpoint (Settings → API keys)
MICROCMS_API_KEY=
# true = keys required, false = allow mock events. Unset = required on hosted builds (CI/Vercel/Netlify/CF Pages).
MICROCMS_REQUIRED=

# Public URL of the site (canonical, OGP, sitemap, JSON-LD). Required on hosted builds.
SITE_URL=
