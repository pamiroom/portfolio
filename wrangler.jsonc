{
  // Cloudflare Worker for the microCMS screen preview (preview.pami.ooo).
  // The public site (pami.ooo) is the static build on XServer and does not use this.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pami-preview",
  // Thin wrapper around @astrojs/cloudflare/handler (see src/worker.ts).
  "main": "./src/worker.ts",
  // Newest date the bundled workerd supports, so local runs match production.
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  // Static build output (the same pages XServer serves) plus the preview route.
  // run_worker_first: every request passes src/worker.ts, which marks the whole
  // preview host noindex and serves files from the ASSETS binding.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": true
  },
  // Workers Logs are left off on purpose: they would store each request URL,
  // including ?draftKey=…. Use `wrangler tail` for live debugging instead.
  "observability": {
    "enabled": false
  }
}
