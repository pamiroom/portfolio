---
/**
 * Pixel stars, sparkles, dots and tiny p's drifting in the side margins.
 * Positions come from a seeded PRNG, so every build renders the same sky
 * (no randomness at runtime, nothing to hydrate).
 */
type Props = {
  /** Change to get a different but stable arrangement. */
  seed?: number;
  count?: number;
  /** How far down the page (in viewport heights) the sparse stars reach. */
  depth?: number;
};

const { seed = 1, count = 36, depth = 3 } = Astro.props;

const SHAPES = ['star', 'sparkle', 'dot', 'cross', 'ring', 'p'] as const;
/** Relative frequency of each shape, same order as SHAPES. */
const WEIGHTS = [5, 4, 3, 2, 1, 1];
const SIZES = [9, 18, 18, 27, 36]; // multiples of the 9px pixel grid stay crisp
/** Side margins, in vw, that stay clear of the centre column. */
const LEFT = [1, 27];
const RIGHT = [71, 97];
/** Most stars cluster in the first screen, between these viewport heights. */
const CLUSTER = [12, 72];
const CLUSTER_SHARE = 0.7;

function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);
const between = ([min, max]: number[]) => min! + rand() * (max! - min!);
const totalWeight = WEIGHTS.reduce((a, b) => a + b, 0);
const pickShape = () => {
  let r = rand() * totalWeight;
  return SHAPES[WEIGHTS.findIndex((w) => (r -= w) < 0)] ?? 'star';
};

const stars = Array.from({ length: count }, (_, i) => {
  const clustered = i < count * CLUSTER_SHARE;
  return {
    shape: pickShape(),
    x: between(i % 2 ? RIGHT : LEFT),
    y: clustered ? between(CLUSTER) : between([CLUSTER[1]! + 10, depth * 100]),
    size: SIZES[Math.floor(rand() * SIZES.length)]!,
    layer: rand() < 0.5 ? 'near' : 'far',
    twinkle: rand() < 0.35,
    delay: (rand() * 3).toFixed(2),
    tone: rand() < 0.8 ? 'accent' : 'fg',
    // Every third star is dropped on narrow screens to keep the margins calm.
    sparse: i % 3 === 0,
  };
});

const layers = ['far', 'near'] as const;
---

<div class="sky" aria-hidden="true">
  <svg class="sky__sprite" width="0" height="0" shape-rendering="crispEdges">
    <defs>
      <symbol id="sky-star" viewBox="0 0 9 9">
        <path d="M4 0h1v3h1v1h2v1H6v1H5v3H4V6H3V5H1V4h2V3h1z" />
      </symbol>
      <symbol id="sky-sparkle" viewBox="0 0 9 9">
        <path d="M4 1h1v3h3v1H5v3H4V5H1V4h3zM2 2h1v1H2zM6 2h1v1H6zM2 6h1v1H2zM6 6h1v1H6z" />
      </symbol>
      <symbol id="sky-dot" viewBox="0 0 9 9"><path d="M4 4h2v2H4z" /></symbol>
      <symbol id="sky-cross" viewBox="0 0 9 9">
        <path d="M2 2h1v1H2zM3 3h1v1H3zM4 4h1v1H4zM5 5h1v1H5zM6 6h1v1H6zM6 2h1v1H6zM5 3h1v1H5zM3 5h1v1H3zM2 6h1v1H2z" />
      </symbol>
      <symbol id="sky-ring" viewBox="0 0 9 9"><path d="M3 3h3v3H3zM4 4v1h1V4z" fill-rule="evenodd" /></symbol>
      <symbol id="sky-p" viewBox="0 0 9 9"><path d="M2 2h4v1H3v1h2V3h1v2H3v3H2z" /></symbol>
    </defs>
  </svg>
  {
    layers.map((layer) => (
      <div class:list={['sky__layer', `sky__layer--${layer}`]}>
        {stars
          .filter((star) => star.layer === layer)
          .map((star) => (
            <svg
              class:list={['sky__star', `sky__star--${star.tone}`, { 'sky__star--twinkle': star.twinkle, 'sky__star--sparse': star.sparse }]}
              style={`--x:${star.x.toFixed(2)}vw;--y:${star.y.toFixed(1)}svh;--size:${star.size}px;--delay:${star.delay}s`}
            >
              <use href={`#sky-${star.shape}`} />
            </svg>
          ))}
      </div>
    ))
  }
</div>

<style>
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
  }

  .sky__sprite {
    position: absolute;
  }

  .sky__layer {
    position: absolute;
    inset: 0;
  }

  .sky__star {
    position: absolute;
    top: calc(var(--y) + var(--safe-top));
    left: var(--x);
    width: var(--size);
    height: var(--size);
    fill: currentColor;
    shape-rendering: crispEdges;
  }

  .sky__star--accent {
    color: var(--room-accent);
  }

  .sky__star--fg {
    color: var(--room-fg);
  }

  @media (max-width: 47.99em) {
    .sky__star--sparse {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Two-step blink, like an old GIF. */
    .sky__star--twinkle {
      animation: sky-twinkle 2.4s steps(1, end) var(--delay) infinite;
    }

    /* Parallax without JS: layers drift at different speeds as the page scrolls. */
    @supports (animation-timeline: scroll()) {
      .sky__layer {
        animation: sky-drift linear both;
        animation-timeline: scroll(root);
      }

      .sky__layer--far {
        --drift: 30svh;
      }

      .sky__layer--near {
        --drift: -12svh;
      }
    }
  }

  @keyframes sky-twinkle {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes sky-drift {
    to {
      transform: translateY(var(--drift));
    }
  }
</style>
