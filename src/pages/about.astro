---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/common/SiteNav.astro';
import Bio from '../components/about/Bio.astro';
import History from '../components/about/History.astro';
import Clients from '../components/about/Clients.astro';
import { profile } from '../data/profile';
---

<BaseLayout room="about" title="About" description={profile.bioEn}>
  <div class="about__nav"><SiteNav current="about" /></div>
  <Bio />
  <figure class="about__portrait">
    <Image
      src={profile.portrait}
      alt={profile.portraitAlt}
      widths={[240, 400, 640, 800]}
      sizes="(min-width: 100em) 400px, (min-width: 48em) 25vw, 62vw"
      loading="eager"
    />
  </figure>
  <div class="about__records">
    <History sections={profile.history} />
    <Clients clients={profile.clients} />
  </div>
</BaseLayout>

<style>
  .about__nav {
    margin-bottom: var(--space-md);
  }

  .about__portrait {
    width: 62vw;
    margin-top: var(--space-xs);
  }

  .about__portrait :global(img) {
    width: 100%;
  }

  .about__records {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.45em;
    font-size: var(--text-list);
    margin-top: var(--space-md);
    padding-inline-start: 0.5em;
    color: var(--room-sub);
  }

  @media (min-width: 48em) {
    .about__portrait {
      width: clamp(200px, 25vw, 400px);
    }
  }
</style>
