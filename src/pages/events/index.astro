---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/common/SiteNav.astro';
import EventList from '../../components/events/EventList.astro';
import { getPublishedEvents } from '../../lib/events';

const events = await getPublishedEvents();
const current = events.filter((event) => event.status !== 'past');
const past = events.filter((event) => event.status === 'past');
---

<BaseLayout
  room="events"
  title="Events"
  description="PAMI NIGHT and other gatherings, shows and small parties by Pami."
>
  <header class="events-head">
    <SiteNav current="events" />
    <h1 class="events-head__title">Events</h1>
    <p>Nights, shows and gatherings. Mostly in Osaka. Come early, leave late.</p>
  </header>

  {current.length > 0 ? <EventList heading="Now & Next" events={current} /> : <p class="events-empty">Nothing scheduled right now. Check back soon.</p>}
  {past.length > 0 && <EventList heading="Archive" events={past} />}
</BaseLayout>

<style>
  .events-head {
    display: grid;
    gap: var(--space-2xs);
    margin-bottom: var(--space-2xl);
    max-width: 40em;
  }

  .events-head__title {
    margin-top: var(--space-md);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .events-empty {
    margin-bottom: var(--space-2xl);
    font-size: var(--text-md);
  }
</style>
