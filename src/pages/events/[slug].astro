---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetail from '../../components/events/EventDetail.astro';
import EventJsonLd from '../../components/events/EventJsonLd.astro';
import { getPublishedEvents } from '../../lib/events';
import { formatDate } from '../../lib/format';
import { shareImageUrl } from '../../lib/image';

export const getStaticPaths = (async () => {
  const events = await getPublishedEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { event } = Astro.props;

const shareImage = event.image ? await shareImageUrl(event.image, Astro.site) : undefined;
const description = event.description ?? `${formatDate(event.startAt)} ${event.title}${event.venue ? ` at ${event.venue}` : ''}.`;
---

<BaseLayout
  room="events"
  title={event.title}
  description={description}
  image={shareImage}
  type="article"
  back={{ href: '/events/', label: 'ALL EVENTS' }}
>
  <EventJsonLd slot="head" event={event} image={shareImage} />
  <EventDetail event={event} />
</BaseLayout>
